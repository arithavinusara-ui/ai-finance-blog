generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // නැතහොත් ඔබ භාවිතා කරන ඩේටාබේස් වර්ගය
  url      = env("DATABASE_URL")
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}